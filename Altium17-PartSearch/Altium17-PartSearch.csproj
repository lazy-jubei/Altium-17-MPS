<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Altium17-PartSearch</AssemblyName>
    <RootNamespace>Altium17PartSearch</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
    <Version>0.4.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">$(ALTIUM_INSTALL_DIR)</AltiumInstallDir>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">C:\Program Files (x86)\Altium\AD17</AltiumInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Altium.SDK"><HintPath>$(AltiumInstallDir)/System/Altium.SDK.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.SDK.Interfaces"><HintPath>$(AltiumInstallDir)/System/Altium.SDK.Interfaces.dll</HintPath><Private>false</Private></Reference>
    <Content Include="Altium17-PartSearch.Ins;Altium17-PartSearch.rcs"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Target Name="ValidateAltiumSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AltiumInstallDir)/System/Altium.SDK.dll')" Text="Set AltiumInstallDir (or ALTIUM_INSTALL_DIR) to your AD17 installation." />
  </Target>
  <Target Name="WriteAltiumTarget" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)Altium17-PartSearch.target.json" Lines="{&quot;altiumVersion&quot;: &quot;17&quot;, &quot;framework&quot;: &quot;net48&quot;, &quot;architecture&quot;: &quot;x86&quot;}" Overwrite="true" />
  </Target>
</Project>
