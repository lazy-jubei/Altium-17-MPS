<UserControl x:Class="Altium17PartSearch.PartSearch.PartSearchView" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="View_Loaded" MinWidth="360">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,5,0"/></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="EnableRowVirtualization" Value="True"/></Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="5"/><RowDefinition Height="2*" MinHeight="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="searchButton" DockPanel.Dock="Right" Content="Search" Click="Search_Click"/>
            <TextBox x:Name="queryBox" Padding="7,4" VerticalContentAlignment="Center" KeyDown="Query_KeyDown" ToolTip="Manufacturer part number or keywords. Leave empty to browse a category."/>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox x:Name="categoryCombo" Width="180" DisplayMemberPath="Name" SelectionChanged="Category_Changed" Margin="0,0,8,0" ToolTip="Browse component categories"/>
            <ComboBox x:Name="providerCombo" Width="150" DisplayMemberPath="Name" SelectionChanged="Provider_Changed" Margin="0,0,8,0"/>
            <CheckBox x:Name="mpnOnlyBox" Content="Exact MPN" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="inStockBox" Content="In stock" VerticalAlignment="Center"/>
        </WrapPanel>
        <Expander x:Name="filtersExpander" Grid.Row="2" Header="Filters" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <StackPanel x:Name="passiveFilters" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Minimum"/><TextBlock Grid.Column="2" Text="Maximum"/>
                    </Grid>
                    <ItemsControl x:Name="rangeFilters"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Example}" Margin="0,0,6,0" Padding="4,3" KeyDown="Query_KeyDown"/>
                            <TextBox Grid.Column="2" Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Example}" Padding="4,3" KeyDown="Query_KeyDown"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock x:Name="rangeHint" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Package" Width="85" VerticalAlignment="Center"/>
                        <TextBox x:Name="packageFilter" Width="150" Padding="4,3" TextChanged="Filter_Changed" ToolTip="Case/package, e.g. 0201 or 0603"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,4"><TextBlock Text="Manufacturer"/><TextBox x:Name="manufacturerFilter" Width="155" TextChanged="Filter_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,8,4"><TextBlock Text="Parameter"/><TextBox x:Name="parameterFilter" Width="130" TextChanged="Filter_Changed" ToolTip="Parameter name, such as Resistance"/></StackPanel>
                    <StackPanel Margin="0,0,0,4"><TextBlock Text="Value contains"/><TextBox x:Name="valueFilter" Width="140" TextChanged="Filter_Changed" ToolTip="Parameter value, such as 10 kOhm"/></StackPanel>
                </WrapPanel>
                <DockPanel Margin="0,4,0,0"><Button x:Name="clearFiltersButton" DockPanel.Dock="Right" Content="Clear filters" Click="ClearFilters_Click"/>
                    <TextBlock x:Name="filterError" Foreground="#A03020" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Expander>
        <DataGrid x:Name="resultsGrid" Grid.Row="3" SelectionChanged="Part_Changed" MouseDoubleClick="Place_Click">
            <DataGrid.ContextMenu><ContextMenu>
                <MenuItem x:Name="placeMenu" Header="Place part" Click="Place_Click"/>
                <MenuItem x:Name="downloadMenu" Header="Download to library" Click="Cloud_Click"/>
                <Separator/><MenuItem Header="Copy parameters" Click="Copy_Click"/>
            </ContextMenu></DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="MPN" Binding="{Binding Mpn}" Width="150" MinWidth="150"/>
                <DataGridTextColumn x:Name="passiveValueColumn" Header="Value" Binding="{Binding PassiveValueDisplay}" SortMemberPath="PassiveValueNumeric" Width="110" MinWidth="110" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding AvailableStock, StringFormat=N0, TargetNullValue=Unknown}" Width="90" MinWidth="80" SortMemberPath="AvailableStock">
                    <DataGridTextColumn.Header><TextBlock Text="Stock" ToolTip="Largest reported listing. Compare each distributor in Stock &amp; prices."/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="120" MinWidth="100"/>
                <DataGridTextColumn x:Name="passiveRatingColumn" Header="Rating" Binding="{Binding PassiveRatingDisplay}" SortMemberPath="PassiveRatingNumeric" Width="85" MinWidth="70" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="passiveToleranceColumn" Header="Tolerance" Binding="{Binding PassiveToleranceDisplay}" SortMemberPath="PassiveToleranceNumeric" Width="85" MinWidth="85" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="110" MinWidth="85"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="partTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBlock x:Name="descriptionText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="stockSummary" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TabControl x:Name="detailsTabs" Grid.Row="3">
                <TabItem x:Name="previewTab" Header="Preview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <Button x:Name="previewButton" Content="Load CAD preview" Click="Preview_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="previewText" Text="Select a part to preview its CAD models." TextWrapping="Wrap" Margin="0,8"/>
                            <DockPanel Margin="0,0,0,5"><TextBlock Text="Symbol" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="symbolPartCombo" Width="100" Margin="10,0,0,0" SelectionChanged="SymbolPart_Changed"/></DockPanel>
                            <Border BorderBrush="#BBB" BorderThickness="1" Background="White"><Image x:Name="symbolImage" Height="160" Stretch="Uniform"/></Border>
                            <DockPanel Margin="0,10,0,5"><TextBlock Text="Footprint" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="footprintCombo" DisplayMemberPath="Name" MinWidth="150" Margin="10,0,0,0" SelectionChanged="Footprint_Changed"/></DockPanel>
                            <Border BorderBrush="#BBB" BorderThickness="1" Background="#111"><Image x:Name="footprintImage" Height="160" Stretch="Uniform"/></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Parameters"><DataGrid x:Name="parameterGrid"><DataGrid.Columns>
                    <DataGridTextColumn Header="Parameter" Binding="{Binding Key}" Width="*"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                </DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Stock &amp; prices"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="refreshStockButton" DockPanel.Dock="Right" Content="Refresh stock" Click="RefreshStock_Click"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="quantityBox" Text="1" Width="90" Padding="5,3" VerticalContentAlignment="Center" TextChanged="Quantity_Changed"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="quantityError" Grid.Row="1" Foreground="#A03020" TextWrapping="Wrap"/>
                    <DataGrid x:Name="offerGrid" Grid.Row="2" SelectionChanged="Offer_Changed" MouseDoubleClick="Supplier_Click"><DataGrid.Columns>
                        <DataGridTextColumn Header="Distributor" Binding="{Binding Supplier}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="In stock" Binding="{Binding StockDisplay}" SortMemberPath="Stock" Width="85"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice}" CanUserSort="False" Width="110"/>
                        <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" SortMemberPath="CanSupply" Width="110"/>
                    </DataGrid.Columns></DataGrid>
                    <TextBox x:Name="priceText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8,0,0" MinHeight="55"/>
                </Grid></TabItem>
                <TabItem x:Name="modelsTab" Header="Models"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="modelText" Text="Place part downloads matching symbols and footprints automatically. If several revisions match, choose one below." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DataGrid x:Name="modelGrid" Grid.Row="1" SelectionChanged="Model_Changed"><DataGrid.Columns>
                        <DataGridTextColumn Header="Vault" Binding="{Binding VaultName}" Width="*"/>
                        <DataGridTextColumn Header="Revision" Binding="{Binding Reference}" Width="*"/>
                    </DataGrid.Columns></DataGrid>
                </Grid></TabItem>
            </TabControl>
            <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="datasheetButton" Content="Datasheet" Click="Datasheet_Click" IsEnabled="False"/>
                <Button x:Name="supplierButton" Content="Supplier page" Click="Supplier_Click" IsEnabled="False"/>
                <Button x:Name="copyButton" Content="Copy parameters" Click="Copy_Click" IsEnabled="False"/>
            </WrapPanel>
        </Grid>
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="statusText" Text="Enter an MPN or choose a category." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="placeButton" Content="Place part" Click="Place_Click" IsEnabled="False" FontWeight="SemiBold"/>
                <Button x:Name="cloudButton" Content="Download to library" Click="Cloud_Click" IsEnabled="False"/>
                <Button x:Name="importButton" Content="Choose local model…" Click="Import_Click" IsEnabled="False"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock x:Name="pageText" VerticalAlignment="Center" Margin="6,0"/>
                <Button x:Name="nextButton" Content="Load more" Click="Next_Click" IsEnabled="False"/>
                <Button x:Name="cancelSearchButton" Content="Cancel" Click="CancelSearch_Click" IsEnabled="False"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
