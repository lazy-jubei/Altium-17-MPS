<Window x:Class="Altium17PartSearch.PartSearch.PartSearchWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manufacturer Part Search" Width="1200" Height="760" MinWidth="1000" MinHeight="600"
    WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Loaded="Window_Loaded"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="4,0"/></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="providerCombo" DisplayMemberPath="Name" Margin="0,0,8,0" VerticalContentAlignment="Center" SelectionChanged="Provider_Changed"/>
            <TextBox x:Name="queryBox" Grid.Column="1" Padding="7,4" VerticalContentAlignment="Center" KeyDown="Query_KeyDown" ToolTip="Manufacturer part number or description"/>
            <CheckBox x:Name="mpnOnlyBox" Grid.Column="2" Content="MPN only" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <CheckBox x:Name="inStockBox" Grid.Column="3" Content="In stock" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <Button x:Name="searchButton" Grid.Column="4" Content="Search" Click="Search_Click"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Filter this page:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Manufacturer" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="manufacturerFilter" Width="155" TextChanged="Filter_Changed" Margin="0,0,12,0"/>
            <TextBlock Text="Parameter" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="parameterFilter" Width="130" TextChanged="Filter_Changed" Margin="0,0,12,0" ToolTip="Parameter name, such as Resistance"/>
            <TextBlock Text="Contains" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="valueFilter" Width="140" TextChanged="Filter_Changed" ToolTip="Parameter value, such as 10 kOhm"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="resultsGrid" SelectionChanged="Part_Changed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
                    <DataGridTextColumn Header="MPN" Binding="{Binding Mpn}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="Suppliers" Binding="{Binding Suppliers}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="partTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,4,7"/>
                <TextBlock x:Name="descriptionText" Grid.Row="1" TextWrapping="Wrap" Margin="4,0,4,10"/>
                <TabControl x:Name="detailsTabs" Grid.Row="2">
                    <TabItem Header="Parameters">
                        <DataGrid x:Name="parameterGrid">
                            <DataGrid.Columns><DataGridTextColumn Header="Parameter" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/></DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Suppliers">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="offerGrid" SelectionChanged="Offer_Changed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="*"/>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox x:Name="priceText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="6" MinHeight="60"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="modelsTab" Header="Models">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Download matching CAD models from a connected Altium Vault, or choose an installed library component. Review pins and footprints before use." TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <DataGrid x:Name="modelGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vault" Binding="{Binding VaultName}" Width="*"/>
                                    <DataGridTextColumn Header="Revision" Binding="{Binding Reference}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="datasheetButton" Content="Datasheet" Click="Datasheet_Click" IsEnabled="False"/>
                    <Button x:Name="supplierButton" Content="Supplier page" Click="Supplier_Click" IsEnabled="False"/>
                    <Button x:Name="copyButton" Content="Copy parameters" Click="Copy_Click" IsEnabled="False"/>
                </WrapPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="statusText" Text="Search the suppliers enabled in Altium." TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="placeBox" Content="Place at schematic origin" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="cloudButton" Content="Download CAD models" Click="Cloud_Click" IsEnabled="False"/>
                    <Button x:Name="importButton" Content="Import library component..." Click="Import_Click" IsEnabled="False"/>
                    <Button Content="Close" IsCancel="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="previousButton" Content="Previous" Click="Previous_Click" IsEnabled="False"/>
                    <TextBlock x:Name="pageText" VerticalAlignment="Center" Margin="6,0"/>
                    <Button x:Name="nextButton" Content="Next" Click="Next_Click" IsEnabled="False"/>
                    <Button x:Name="cancelSearchButton" Content="Cancel" Click="CancelSearch_Click" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
